+    ?? places.find((x) => x.kind === 'city' && x.countryCode && idea.destination.country && x.lat && idea.destination.lat !== null && Math.abs(x.lat - idea.destination.lat) < 0.6 && Math.abs(x.lng - idea.destination.lng) < 0.6);
