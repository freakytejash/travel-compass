# Travel Compass environment template. Copy to .env for local development ONLY.
# In production, set these in your platform's secret manager — never commit real values.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000            # must be https:// in production; used for OAuth redirects and email links
TRUST_PROXY=false                        # true behind a load balancer that sets X-Forwarded-For
LOG_LEVEL=info

# --- Core (required) ---
DATABASE_URL=postgres://tc:devpass@127.0.0.1:5433/travel_compass   # add ?sslmode=verify-full for managed Postgres
DB_POOL_SIZE=10
TOKEN_ENCRYPTION_KEY=                    # 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_EMAILS=                            # comma-separated; these accounts get the admin role when they sign up
SESSION_DAYS=30
RUN_WORKER_IN_PROCESS=true               # false when running `npm run start:worker` separately
MIGRATE_ON_START=true

# --- Transactional email (verification, password reset) ---
RESEND_API_KEY=
EMAIL_FROM="Travel Compass <no-reply@your-domain.example>"

# --- Google: sign-in and customer Gmail import (one OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorised redirect URI to register in Google Cloud: ${APP_URL}/api/oauth/google/callback

# --- Flights / stays / checkout (Duffel) ---
DUFFEL_ACCESS_TOKEN=                     # duffel_test_... for sandbox, duffel_live_... after go-live approval
DUFFEL_STAYS_ENABLED=false               # true only after Duffel approves Stays access
DUFFEL_LINKS_ENABLED=false               # true after enabling Duffel Links (hosted checkout)

# --- Booking.com Demand API (affiliate partners only) ---
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_BASE_URL=https://demandapi.booking.com/3.1   # sandbox: verify in your Booking.com partner portal

# --- Maps & places ---
GOOGLE_MAPS_API_KEY=                     # enable Places API (New) and Routes API; restrict the key to those APIs

# --- Weather (Open-Meteo) ---
OPEN_METEO_API_KEY=                      # required for commercial use
OPEN_METEO_ALLOW_FREE_TIER=true          # non-commercial/dev only; defaults to false in production

# --- AI planning (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=25
AI_PER_USER_DAILY_BUDGET_USD=1.5
AI_INPUT_USD_PER_MTOK=3                  # used for cost estimates only; set to your contracted price
AI_OUTPUT_USD_PER_MTOK=15

# --- Web research (hike facts, menus, local dishes) ---
BRAVE_SEARCH_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=                   # system-user token, not the temporary test token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                     # used to verify webhook signatures
WHATSAPP_WEBHOOK_VERIFY_TOKEN=           # any random string; also entered in the Meta webhook config
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_VERIFICATION=tc_verification_code
WHATSAPP_TEMPLATE_PRETRIP=tc_pretrip_briefing
WHATSAPP_TEMPLATE_DAILY=tc_daily_schedule
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Limits ---
FLEX_MAX_COMBOS=49
FLEX_STAY_QUOTE_COMBOS=6
PROVIDER_CONCURRENCY=4
API_RATE_PER_MINUTE=120
AUTH_RATE_PER_MINUTE=10
EXPENSIVE_RATE_PER_HOUR=30

# --- Retention (days) ---
RETENTION_PROVIDER_USAGE_DAYS=90
RETENTION_ERROR_EVENTS_DAYS=30
RETENTION_JOBS_DAYS=30

# --- Tests ---
TEST_DATABASE_URL=postgres://tc:devpass@127.0.0.1:5433/travel_compass_test
