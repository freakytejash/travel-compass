# Travel Compass — FREE setup (personal, non-commercial use). Copy to .env and fill in the 4 marked values.
# Every service below is free: no card is needed except where noted in docs/FREE_SETUP.md.

NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000                 # or your free tunnel URL, e.g. https://travel.yourname.ts.net
DATABASE_URL=postgres://tc:devpass@db:5432/travel_compass   # docker compose Postgres (free). Neon free tier also works.
TOKEN_ENCRYPTION_KEY=                         # (1) node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_EMAILS=you@example.com                 # the email you sign up with gets the admin page
RUN_WORKER_IN_PROCESS=true

# Email: personal use without an email provider — links are printed in the server log (docker compose logs web).
# For real emails use Resend's free plan instead (3,000/month): set RESEND_API_KEY + EMAIL_FROM and EMAIL_LOG_ONLY=false.
EMAIL_LOG_ONLY=true
RESEND_API_KEY=
EMAIL_FROM="Travel Compass <onboarding@resend.dev>"

# Flights + hotels: SerpApi free plan, 250 searches/month (Google Flights / Google Hotels results)
SERPAPI_API_KEY=                              # (2) https://serpapi.com/users/sign_up
SERPAPI_MONTHLY_LIMIT=240                     # stop a little before the free allowance
SERPAPI_COUNTRY=be

# AI: Groq free tier (OpenAI-compatible). Alternative: local Ollama, see docs/FREE_SETUP.md.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=                                   # (3) https://console.groq.com/keys
AI_MODEL=llama-3.3-70b-versatile
AI_INPUT_USD_PER_MTOK=0
AI_OUTPUT_USD_PER_MTOK=0
AI_DAILY_BUDGET_USD=1                          # cost estimates are 0, so this never blocks; Groq's own rate limits apply

# Reminders: Telegram bot (free). Create it with @BotFather.
TELEGRAM_BOT_TOKEN=                           # (4) from @BotFather
TELEGRAM_BOT_USERNAME=                        # e.g. TejashTravelBot (without @)
TELEGRAM_MODE=polling                         # works without a public URL
TELEGRAM_WEBHOOK_SECRET=

# Weather, venues, research, places: free and key-less
OPEN_METEO_ALLOW_FREE_TIER=true               # Open-Meteo free tier: non-commercial use only
PHOTON_URL=https://photon.komoot.io
OVERPASS_URL=https://overpass-api.de/api/interpreter
DATA_DIR=./data

# Optional, free: Google sign-in and Gmail import for your own inbox (OAuth app in "testing" mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave the paid providers empty to use the free stack
DUFFEL_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
WHATSAPP_ACCESS_TOKEN=
